diff --git a/src/tools/pw-loopback.c b/src/tools/pw-loopback.c
index 1d76eb284..991934a37 100644
--- a/src/tools/pw-loopback.c
+++ b/src/tools/pw-loopback.c
@@ -91,7 +91,7 @@ int main(int argc, char *argv[])
