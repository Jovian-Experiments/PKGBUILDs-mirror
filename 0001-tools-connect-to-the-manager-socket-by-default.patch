+	if (opt_remote)
+		remote_name = opt_remote;
+
 	data.core = pw_context_connect(data.context,
 			pw_properties_new(
 				PW_KEY_REMOTE_INTENTION, "manager",
-				PW_KEY_REMOTE_NAME, opt_remote,
+				PW_KEY_REMOTE_NAME, remote_name,
 				NULL),
 			0);
 	if (data.core == NULL) {
